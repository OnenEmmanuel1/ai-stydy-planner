<%- include('partials/head',{title:'Administration'}) %><%- include('partials/nav',{user}) %><main class="container py-4"><h1 class="h2">Administration</h1><p class="aissp-muted">Manage accounts and shared assistant content; review recent system activity.</p><div class="row g-4"><div class="col-lg-5"><section class="aissp-card p-4 mb-4"><h2 class="h5">Create account</h2><form data-aissp-form data-endpoint="/api/admin/users"><input class="form-control mb-2" name="fullName" placeholder="Full name" required><input class="form-control mb-2" type="email" name="email" placeholder="Email" required><input class="form-control mb-2" type="password" name="password" placeholder="Password (10+ characters)" minlength="10" required><select class="form-select mb-2" name="role"><option>Student</option><option>Admin</option></select><button class="btn btn-primary">Create user</button><p class="small mt-2" data-result></p></form></section><section class="aissp-card p-4 mb-4"><h2 class="h5">Emotion lexicon</h2><form data-aissp-form data-endpoint="/api/admin/lexicon"><input class="form-control mb-2" name="word" placeholder="Keyword" required><select class="form-select mb-2" name="emotion"><% ['Stressed','Fatigued','Motivated','Frustrated'].forEach(x=>{ %><option><%= x %></option><% }) %></select><input class="form-control mb-2" type="number" min=".1" max="9" step=".1" value="1" name="weight"><button class="btn btn-outline-primary">Add or update word</button><p class="small mt-2" data-result></p></form><div class="small mt-2"><% lexicon.forEach(x=>{ %><span class="badge text-bg-light me-1 mb-1"><%= x.word %> · <%= x.emotion %> <button class="btn-close ms-1" data-aissp-delete="/api/admin/lexicon/<%= x.entryId %>"></button></span><% }) %></div></section><section class="aissp-card p-4"><h2 class="h5">Response templates</h2><form data-aissp-form data-endpoint="/api/admin/templates"><input class="form-control mb-2" name="intent" placeholder="Intent, e.g. AskSchedule" required><select class="form-select mb-2" name="emotion"><% ['Stressed','Fatigued','Motivated','Frustrated','Neutral'].forEach(x=>{ %><option><%= x %></option><% }) %></select><textarea class="form-control mb-2" name="responseText" rows="3" required placeholder="Supportive response"></textarea><button class="btn btn-outline-primary">Save template</button><p class="small mt-2" data-result></p></form><% templates.forEach(x=>{ %><div class="small border-top py-2"><b><%= x.intent %> · <%= x.emotion %></b>: <%= x.responseText %></div><% }) %></section></div><div class="col-lg-7"><section class="aissp-card p-4 mb-4"><h2 class="h5">Accounts</h2><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead><tbody><% users.forEach(x=>{ %><tr><td><%= x.fullName %></td><td><%= x.email %></td><td><%= x.role %></td><td><% if(x.userId!==user.userId){ %><button class="btn btn-sm btn-outline-danger" data-aissp-delete="/api/admin/users/<%= x.userId %>">Delete</button><% } %></td></tr><% }) %></tbody></table></div></section><section class="aissp-card p-4 mb-4"><h2 class="h5">Scheduling weights</h2><p class="small aissp-muted">Set one shared weighting for a student account. Values must sum to 1.0.</p><form data-aissp-form data-endpoint="/api/weights" data-method="PUT"><select class="form-select mb-2" name="userId"><% users.filter(x=>x.role==='Student').forEach(x=>{ %><option value="<%= x.userId %>"><%= x.fullName %></option><% }) %></select><div class="row"><div class="col"><label class="form-label">Urgency</label><input class="form-control" type="number" name="urgencyWeight" min="0" max="1" step=".01" value=".55"></div><div class="col"><label class="form-label">Workload</label><input class="form-control" type="number" name="workloadWeight" min="0" max="1" step=".01" value=".25"></div><div class="col"><label class="form-label">Preference</label><input class="form-control" type="number" name="preferenceWeight" min="0" max="1" step=".01" value=".20"></div></div><button class="btn btn-outline-primary mt-3">Save weights</button><p class="small mt-2" data-result></p></form></section><section class="aissp-card p-4"><h2 class="h5">Recent activity</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>When</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody><% activity.forEach(x=>{ %><tr><td><%= new Date(x.createdAt).toLocaleString() %></td><td><%= x.fullName||'System' %></td><td><%= x.action %></td><td><%= x.details||'' %></td></tr><% }) %></tbody></table></div></section><section class="aissp-card p-4 mt-4"><h2 class="h5">Crisis support contact</h2><p class="small aissp-muted">This text is included in crisis escalations. Keep it current for your campus.</p><form data-aissp-form data-endpoint="/api/admin/settings/crisis-contact" data-method="PUT"><textarea class="form-control mb-2" name="value" rows="3" maxlength="1000" required><%= crisisContact %></textarea><button class="btn btn-outline-primary">Save contact details</button><p class="small mt-2" data-result></p></form></section></div></div></main><script src="/js/app.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
