<%- include('partials/head',{title:'Study assistant'}) %><%- include('partials/nav',{user}) %><main class="container py-4"><div class="row justify-content-center"><div class="col-lg-8"><h1 class="h2">Study assistant</h1><p class="aissp-muted">Ask about your schedule or study approach. Messages are classified with a rule-based text lexicon to adapt supportive replies.</p><section class="aissp-card p-3"><div class="aissp-chat" id="aissp-chat-messages" aria-live="polite"><% messages.forEach(m=>{ %><div class="aissp-message <%= m.sender==='User'?'aissp-user':'aissp-bot' %>"><strong><%= m.sender==='User'?'You':`Assistant${m.detectedEmotion?` · ${m.detectedEmotion}`:''}` %></strong><p class="mb-0"><%= m.content %></p></div><% }) %></div><form id="aissp-chat-form" class="d-flex gap-2 mt-3"><input class="form-control" name="message" placeholder="What would you like help with?" maxlength="4000" required><button class="btn btn-primary">Send</button></form></section><p class="small aissp-muted mt-3">This assistant supports academic planning and does not replace professional counselling services. If you may be in immediate danger, contact your local emergency service.</p></div></div></main><script src="/js/app.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
