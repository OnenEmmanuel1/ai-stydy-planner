<%- include('partials/head',{title:'Study planner'}) %><%- include('partials/nav',{user}) %><main class="container py-4"><h1 class="h2">Study planner</h1><p class="aissp-muted">Tasks are ranked by deadline urgency, workload, and your preference, then allocated in 30-minute sessions.</p><div class="row g-4"><div class="col-lg-5"><section class="aissp-card p-4 mb-4"><h2 class="h5">Courses</h2><form data-aissp-form data-endpoint="/api/courses"><input class="form-control mb-2" name="name" placeholder="Course name" required maxlength="100"><button class="btn btn-outline-primary">Add course</button><span class="small ms-2" data-result></span></form><div class="mt-3"><% courses.forEach(c=>{ %><span class="badge text-bg-light me-2 mb-2"><%= c.name %> <button class="btn-close ms-1" aria-label="Delete course" data-aissp-delete="/api/courses/<%= c.courseId %>"></button></span><% }) %></div></section><section class="aissp-card p-4"><h2 class="h5">Add a study task</h2><form data-aissp-form data-endpoint="/api/tasks" data-reload="true"><label class="form-label">Task title</label><input class="form-control mb-2" name="title" required maxlength="150"><label class="form-label">Course</label><select class="form-select mb-2" name="courseId"><option value="">No course</option><% courses.forEach(c=>{ %><option value="<%= c.courseId %>"><%= c.name %></option><% }) %></select><label class="form-label">Deadline</label><input class="form-control mb-2" type="datetime-local" name="deadline" required><label class="form-label">Estimated workload (hours)</label><input class="form-control mb-2" type="number" min="0.25" step="0.25" name="estimatedWorkloadHours" required><label class="form-label">Priority preference (1–5)</label><input class="form-control mb-3" type="number" min="1" max="5" value="3" name="preferenceWeight"><button class="btn btn-primary">Save task and schedule</button><p class="small mt-2" data-result></p></form></section></div><div class="col-lg-7"><section class="aissp-card p-4 mb-4"><h2 class="h5">Weekly availability</h2><form data-aissp-form data-endpoint="/api/availability" data-reload="true" class="row g-2 align-items-end"><div class="col-4"><label class="form-label">Day</label><select class="form-select" name="dayOfWeek"><% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(d=>{ %><option><%= d %></option><% }) %></select></div><div class="col-3"><label class="form-label">From</label><input class="form-control" type="time" name="startTime" required></div><div class="col-3"><label class="form-label">To</label><input class="form-control" type="time" name="endTime" required></div><div class="col-2"><button class="btn btn-outline-primary">Add</button></div><div class="col-12 small" data-result></div></form><div class="mt-3"><% availability.forEach(a=>{ %><span class="badge text-bg-light me-2 mb-2"><%= a.dayOfWeek %> <%= String(a.startTime).slice(0,5) %>-<%= String(a.endTime).slice(0,5) %> <button class="btn-close ms-1" aria-label="Remove" data-aissp-delete="/api/availability/<%= a.availabilityId %>"></button></span><% }) %></div></section><section class="aissp-card p-4"><h2 class="h5">Tasks and generated allocation</h2><% tasks.forEach(t=>{ %><div class="border-bottom py-3 d-flex justify-content-between gap-3"><div><strong><%= t.title %></strong><div class="small aissp-muted"><%= t.courseName||'No course' %> · due <%= new Date(t.deadline).toLocaleString() %> · <%= t.estimatedWorkloadHours %>h · preference <%= t.preferenceWeight %>/5</div><button class="btn btn-sm btn-outline-secondary mt-2" data-task-edit data-id="<%= t.taskId %>" data-title="<%= t.title %>" data-course="<%= t.courseId||'' %>" data-deadline="<%= new Date(t.deadline).toISOString().slice(0,16) %>" data-hours="<%= t.estimatedWorkloadHours %>" data-preference="<%= t.preferenceWeight %>">Edit</button> <button class="btn btn-sm btn-outline-danger mt-2" data-aissp-delete="/api/tasks/<%= t.taskId %>">Delete</button></div><span class="badge <%= t.status==='Unscheduled'?'text-bg-warning':'text-bg-primary' %> align-self-start"><%= t.status %></span></div><% }) %></section></div></div></main><script src="/js/app.js"></script><script>document.querySelectorAll('[data-task-edit]').forEach(b=>b.addEventListener('click',async()=>{const title=prompt('Task title',b.dataset.title);if(title===null)return;const deadline=prompt('Deadline (YYYY-MM-DDTHH:mm)',b.dataset.deadline);if(!deadline)return;const hours=prompt('Estimated workload hours',b.dataset.hours);if(hours===null)return;const preferenceWeight=prompt('Priority preference (1-5)',b.dataset.preference);if(preferenceWeight===null)return;try{await aisspRequest('/api/tasks/'+b.dataset.id,{method:'PUT',body:JSON.stringify({title,courseId:b.dataset.course||null,deadline,estimatedWorkloadHours:hours,preferenceWeight,status:'Pending'})});location.reload()}catch(e){alert(e.message)}}));</script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
