<%- include('partials/head',{title:'Dashboard'}) %><%- include('partials/nav',{user}) %>
<main class="container-fluid aissp-main py-4 py-lg-5">
  <header class="aissp-page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 mb-lg-5"><div><p class="aissp-eyebrow mb-2">YOUR STUDY SPACE</p><h1 class="h2 mb-1">Welcome, <%= user.fullName.split(' ')[0] %>.</h1><p class="aissp-muted mb-0">Here’s a calm view of what’s ahead today.</p></div><a class="btn aissp-primary-btn" href="/planner"><span aria-hidden="true">＋</span> Plan your study</a></header>
  <% const total=Number(counts.total)||0, completed=Number(counts.completed)||0, completion=total?Math.round(completed/total*100):0; %>
  <div class="row g-3 g-xl-4 mb-4 mb-lg-5">
    <div class="col-6 col-xl-3"><section class="aissp-metric"><span class="aissp-metric-icon">▤</span><span class="aissp-metric-label">Total tasks</span><strong><%= total %></strong><small>Across all your courses</small></section></div>
    <div class="col-6 col-xl-3"><section class="aissp-metric"><span class="aissp-metric-icon aissp-icon-green">✓</span><span class="aissp-metric-label">Completed</span><strong><%= completed %></strong><small><%= completion %>% of your task list</small></section></div>
    <div class="col-6 col-xl-3"><section class="aissp-metric"><span class="aissp-metric-icon aissp-icon-purple">◷</span><span class="aissp-metric-label">Scheduled</span><strong><%= Number(counts.scheduled)||0 %></strong><small>Ready for a focused session</small></section></div>
    <div class="col-6 col-xl-3"><section class="aissp-metric"><span class="aissp-metric-icon aissp-icon-amber">!</span><span class="aissp-metric-label">Need a plan</span><strong><%= Number(counts.unscheduled)||0 %></strong><small>Tasks needing more study time</small></section></div>
  </div>
  <div class="row g-4">
    <div class="col-xl-8">
      <section class="aissp-panel mb-4"><div class="aissp-panel-heading"><div><h2 class="h5 mb-1">Your tasks</h2><p class="aissp-muted small mb-0">Progress and deadlines from your planner</p></div><a class="aissp-text-link" href="/planner">Open planner <span aria-hidden="true">→</span></a></div>
        <% if(tasks.length){ %><div class="table-responsive"><table class="table aissp-table align-middle mb-0"><thead><tr><th>Task</th><th>Course</th><th>Deadline</th><th>Status</th></tr></thead><tbody><% tasks.forEach(t=>{ %><tr><td class="fw-semibold"><%= t.title %></td><td><%= t.courseName||'—' %></td><td><%= new Date(t.deadline).toLocaleDateString() %></td><td><span class="aissp-status aissp-status-<%= t.status.toLowerCase() %>"><%= t.status %></span></td></tr><% }) %></tbody></table></div><% }else{ %><div class="aissp-empty"><p class="mb-2">Your task list is ready when you are.</p><a href="/planner">Add your first task →</a></div><% } %>
      </section>
      <section class="aissp-panel"><div class="aissp-panel-heading"><div><h2 class="h5 mb-1">Study progress</h2><p class="aissp-muted small mb-0">Your completed tasks and check-ins over time</p></div><span class="aissp-data-note">From your activity</span></div><div class="p-3 p-lg-4"><div class="aissp-progress-summary"><div><strong><%= completion %>%</strong><span> tasks completed</span></div><div class="aissp-progress-track"><span style="width:<%= completion %>%"></span></div></div><div class="aissp-chart-wrap"><canvas id="emotionChart" role="img" aria-label="Emotion check-in trend from your recorded chat messages"></canvas></div></div></section>
    </div>
    <div class="col-xl-4">
      <section class="aissp-panel aissp-schedule-panel mb-4"><div class="aissp-panel-heading"><div><h2 class="h5 mb-1">Upcoming sessions</h2><p class="aissp-muted small mb-0">Your next study blocks</p></div><span class="aissp-count-pill"><%= sessions.length %></span></div>
        <% if(sessions.length){ %><div class="aissp-timeline"><% sessions.forEach(s=>{ %><article class="aissp-session"><span class="aissp-timeline-dot" aria-hidden="true"></span><div class="aissp-session-time"><%= new Date(s.scheduledStart).toLocaleDateString([], {weekday:'short',month:'short',day:'numeric'}) %> · <%= new Date(s.scheduledStart).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'}) %></div><h3><%= s.title %></h3><button class="btn btn-sm aissp-complete-btn" data-aissp-session-complete="/api/sessions/<%= s.sessionId %>/complete">Mark complete</button></article><% }) %></div><% }else{ %><div class="aissp-empty"><p class="mb-2">No sessions scheduled yet.</p><a href="/planner">Set availability and plan →</a></div><% } %>
      </section>
      <section class="aissp-panel"><div class="aissp-panel-heading"><div><h2 class="h5 mb-1">A quick check-in</h2><p class="aissp-muted small mb-0">Make space for how studying feels</p></div></div><div class="p-4"><p class="aissp-checkin-copy">A small, steady step is enough for today. Your study assistant can help you adjust your plan around your energy.</p><a class="btn aissp-soft-btn" href="/chat">Talk through your next step <span aria-hidden="true">→</span></a></div></section>
    </div>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script>const rows=<%- JSON.stringify(emotions) %>;const labels=[...new Set(rows.map(r=>new Date(r.day).toLocaleDateString()))].reverse();const kinds=['Stressed','Fatigued','Motivated','Frustrated','Neutral'];new Chart(document.getElementById('emotionChart'),{type:'line',data:{labels,datasets:kinds.map((k,i)=>({label:k,data:labels.map(d=>{const r=rows.find(x=>x.emotion===k&&new Date(x.day).toLocaleDateString()===d);return r?Number(r.count):0}),borderColor:['#d96767','#bf8f42','#1ba67b','#8d78cb','#7d8a84'][i],backgroundColor:'transparent',borderWidth:2,pointRadius:3,pointHoverRadius:5,tension:.28,fill:false}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,padding:18}}},scales:{y:{beginAtZero:true,ticks:{precision:0},grid:{color:'#edf0ed'}},x:{grid:{display:false}}}}});</script><script src="/js/app.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
